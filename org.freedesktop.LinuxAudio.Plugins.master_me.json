{
    "id": "org.freedesktop.LinuxAudio.Plugins.master_me",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "sdk": "org.freedesktop.Sdk//24.08",
    "runtime-version": "stable",
    "build-extension": true,
    "branch": "24.08",
    "build-options": {
        "prefix": "/app/extensions/Plugins/master_me"
    },
    "modules": [
        {
            "name": "faust",
            "buildsystem": "simple",
            "build-options": {
                "cxxflags": "-fpermissive",
                "env": {
                    "PREFIX": "${FLATPAK_DEST}"
                }
            },
            "build-commands": [
                "make",
                "make install"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/share/faust",
                "/share/man",
                "*.a"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/grame-cncm/faust/releases/download/2.41.1/faust-2.41.1.tar.gz",
                    "sha256": "72145e1d4ffcdd8e687ed7960d1d0717fa2c1dd2566e0bbc3a78fa95bb8b683e"
                },
                {
                    "type": "patch",
                    "path": "patches/faust-build.patch"
                }
            ]
        },
        {
            "name": "master_me",
            "buildsystem": "simple",
            "build-options": {
                "prepend-path": "/app/extensions/Plugins/master_me/bin"
            },
            "build-commands": [
                "make",
                "install -Dm755 bin/master_me-vst.so -t ${FLATPAK_DEST}/vst",
                "install -d ${FLATPAK_DEST}/vst3",
                "cp -R bin/master_me.vst3 ${FLATPAK_DEST}/vst3",
                "install -d ${FLATPAK_DEST}/lv2",
                "cp -R bin/master_me*.lv2 ${FLATPAK_DEST}/lv2",
                "install -Dm755 bin/master_me.clap -t ${FLATPAK_DEST}/clap",
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.master_me.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/trummerschlunk/master_me/releases/download/1.3.1/master_me-1.3.1-src.tar.xz",
                    "sha256": "c9fec1249ec67e7cad8a87f786b9ceb05ec82c52c13014a11fc728cdb9705fdd",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/trummerschlunk/master_me/releases/latest",
                        "version-query": ".tag_name | sub(\"^jq-\"; \"\")",
                        "url-query": "\"https://github.com/trummerschlunk/master_me/releases/download/\"  + ($version) + \"/master_me-\"  + ($version) + \"-src.tar.xz\""
                    }

                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.master_me.metainfo.xml"
                }
            ]
        }
    ]
}
